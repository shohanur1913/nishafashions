# ===================================================================
# Nisha Fashions - Production Environment Configuration (.env)
# ===================================================================
# Rename or copy this file to .env and fill in your actual credentials.

# --- Database Configuration (MySQL / MariaDB in cPanel) ---
# Note: On cPanel, DB_USER and DB_NAME usually have your cPanel username prefix (e.g. user_nishadb)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name

# --- Authentication & Admin Security ---
# Generate a strong random string (e.g. 32+ characters) for JWT_SECRET
JWT_SECRET=replace_with_a_long_random_secure_secret_key_12345
ADMIN_DEFAULT_EMAIL=admin@nishafashions.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!

# --- Site URL & Domain Settings ---
# Use your production domain (with https://)
NEXT_PUBLIC_SITE_URL=https://www.nishafashions.com

# --- Optional Search Engine & Analytics Integrations ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# --- Application Runtime ---
NODE_ENV=production
PORT=3000
